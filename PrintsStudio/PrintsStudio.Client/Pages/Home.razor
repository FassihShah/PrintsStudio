@page "/"
@page "/Home/{role}"

<PageTitle>Home | Prints Studio</PageTitle>

<div class="home-page">
    <section class="ps-section">
        <HeroComponent></HeroComponent>
    </section>

    <section class="ps-section ps-delay-1">
        <CaourselComponent></CaourselComponent>
    </section>

    <section class="ps-section ps-delay-2">
        <AboutUsComponent></AboutUsComponent>
    </section>

    <section class="ps-section ps-delay-2">
        <TrendingNowComponent></TrendingNowComponent>
    </section>

    <section class="ps-section ps-delay-3">
        <DesignerComponent></DesignerComponent>
    </section>

    <section class="ps-section ps-delay-4">
        <ReviewCarouselComponent></ReviewCarouselComponent>
    </section>
</div>

@code
{
    [Parameter]
    public string? role { get; set; }
}
