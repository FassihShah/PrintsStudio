@page "/footer"

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    .footer-shell {
        margin: 3rem auto 0;
        max-width: min(1240px, calc(100% - 1.5rem));
        border-radius: 34px 34px 0 0;
        background:
            radial-gradient(circle at top left, rgba(244, 197, 79, 0.16), transparent 24%),
            linear-gradient(135deg, #1a2d66 0%, #10214c 52%, #0d7f8f 100%);
        color: white;
        box-shadow: 0 24px 60px rgba(18, 39, 77, 0.26);
        overflow: hidden;
    }

    .footer {
        padding: 72px 28px 32px;
    }

    .newsletter-box {
        padding: 1.2rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .newsletter-input {
        background-color: rgba(255, 255, 255, 0.92);
        border: none;
        padding: 15px 20px;
        color: #1a2d66;
        width: 100%;
        border-radius: 999px 0 0 999px;
    }

    .newsletter-button {
        background: linear-gradient(135deg, #f4c54f 0%, #e39a25 100%);
        color: #10214c;
        border-radius: 0 999px 999px 0;
        padding: 10px 30px;
        border: none;
        font-weight: 800;
    }

    .heading {
        color: white;
    }

    .footer a, .footer p {
        font-size: 0.98rem;
        color: rgba(255, 255, 255, 0.86);
    }

    .footer-links a {
        text-decoration: none;
        display: inline-block;
        margin-bottom: 10px;
    }

    .footer-links a:hover {
        color: #f4c54f;
        transform: translateX(2px);
    }

    .social-icons a {
        color: white;
        margin-right: 15px;
        font-size: 1.2rem;
    }

    .social-icons a:hover {
        color: #f4c54f;
    }

    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        padding-top: 20px;
        margin-top: 40px;
        text-align: center;
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .footer-shell {
            border-radius: 26px 26px 0 0;
            max-width: calc(100% - 1rem);
        }

        .newsletter-input {
            border-radius: 999px;
            margin-bottom: 0.75rem;
        }

        .newsletter-button {
            border-radius: 999px;
            width: 100%;
        }
    }
</style>

<div class="footer-shell ps-section">
    <div class="container footer">
        <div class="text-center mb-4">
            <h2 class="fw-bold heading">Newsletter</h2>
            <p>Stay up to date with our latest products, offers, and showcase work.</p>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-md-7">
                <div class="newsletter-box">
                    <div class="input-group">
                        <input type="email" class="form-control newsletter-input" placeholder="Your email address">
                        <button class="btn newsletter-button">SIGN UP</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row text-start g-4">
            <div class="col-md-3 footer-links">
                <h4 class="fw-bold heading">Menu</h4>
                <a href="/">Home</a>
                <a href="/aboutus">About Us</a>
                <a href="/catalogue">Our Products</a>
                <a href="/faqs">How We Work</a>
                <a href="/contact">Contact</a>
            </div>

            <div class="col-md-3 footer-links">
                <h4 class="fw-bold heading">Services</h4>
                <a href="/product-detail/9">Business Cards</a>
                <a href="/product-detail/11">Flyers</a>
                <a href="/product-detail/10">Wedding Cards</a>
                <a href="/product-detail/14">Shirts</a>
                <a href="/product-detail/8">House Graphic Design</a>
            </div>

            <div class="social-icons col-md-3">
                <p><strong>Connect</strong> with us on socials for news, deals, and client showcase updates.</p>
                <a href="#"><i class="bi bi-facebook"></i></a>
                <a href="#"><i class="bi bi-twitter"></i></a>
                <a href="#"><i class="bi bi-linkedin"></i></a>
            </div>

            <div class="col-md-3">
                <h4 class="fw-bold heading">Contact</h4>
                <p>327 80 3311 8</p>
                <p>info@printsstudio.com</p>
                <p>Rehmanpura St 16</p>
                <p>LH 5505</p>
            </div>
        </div>

        <div class="footer-bottom mt-5">
            <p>&copy; 2026 <strong>Prints Studio</strong>. All Rights Reserved.</p>
        </div>
    </div>
</div>

@code {
