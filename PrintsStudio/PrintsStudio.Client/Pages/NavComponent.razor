@page "/nav"
@inject IJSRuntime Js
@using PrintsStudio.Client.Models
@inject Services.UserService us

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    .navbar-custom {
        position: sticky;
        top: 0;
        z-index: 30;
        padding: 1rem 1.2rem;
        margin: 1rem auto 1.5rem;
        max-width: min(1240px, calc(100% - 1.5rem));
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.74);
        border: 1px solid rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(16px);
        box-shadow: 0 20px 44px rgba(17, 42, 65, 0.12);
    }

    .navbar-brand {
        color: #142f58;
        font-family: 'Merriweather', serif;
        font-size: 1.35rem;
        letter-spacing: -0.03em;
    }

    .nav-link,
    .logout-btn {
        color: #31505d !important;
        font-weight: 700;
        padding: 0.75rem 1rem;
        border-radius: 999px;
        transition: transform 0.22s ease, background-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
    }

    .nav-link:hover,
    .nav-link:focus,
    .logout-btn:hover,
    .logout-btn:focus {
        background: linear-gradient(135deg, rgba(11, 157, 154, 0.14), rgba(31, 47, 104, 0.1));
        color: #16295b !important;
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(11, 157, 154, 0.14);
    }

    .equal-width-nav {
        display: flex;
        flex: 1;
        justify-content: flex-end;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
    }

    .equal-width-nav .nav-item {
        list-style: none;
    }

    .equal-width-nav .btn-dark {
        background: linear-gradient(135deg, #1f2f68 0%, #0b9d9a 100%);
        border: none;
        border-radius: 999px;
        padding: 0.8rem 1.2rem;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        box-shadow: 0 14px 28px rgba(31, 47, 104, 0.18);
    }

    .equal-width-nav .btn-dark:hover {
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 18px 32px rgba(31, 47, 104, 0.22);
    }

    .logout-btn {
        background: none;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    @@media (max-width: 991.98px) {
        .navbar-custom {
            max-width: calc(100% - 1rem);
            border-radius: 22px;
        }

        .equal-width-nav {
            justify-content: flex-start;
            margin-top: 0.85rem;
        }
    }
</style>

<nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container-fluid px-1">
        <a class="navbar-brand d-flex align-items-center me-auto" href="/">
            <strong>Prints Studio</strong>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav align-items-center w-100">
                <div class="equal-width-nav">
                    <li class="nav-item"><a class="nav-link" href="/aboutus">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="/catalogue">Our Product</a></li>
                    <li class="nav-item"><a class="nav-link" href="/faq">FAQs</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                    @if (Role == "Customer")
                    {
                        <li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
                        <li class="nav-item">
                            <button onclick="logoutUser()" class="logout-btn">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </li>
                    }
                    @if (Role == "Visitor")
                    {
                        <li class="nav-item"><a class="btn btn-dark btn-sm text-white" href="/login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-dark btn-sm text-white" href="/signup">Sign Up</a></li>
                    }
                    @if (Role == "Designer")
                    {
                        <li class="nav-item"><a class="nav-link" href="/all-bookings">My Orders</a></li>
                        <li class="nav-item">
                            <button onclick="logoutUser()" class="logout-btn">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </li>
                    }
                </div>
            </ul>
        </div>
    </div>
</nav>

@code
{
    [Parameter]
    public string Role { get; set; } = "Visitor";

    protected override async Task OnInitializedAsync()
    {
        var userId = await Js.InvokeAsync<string>("localStorage.getItem", "userId");
        if (userId != null)
        {
            var user = await us.GetByIdAsync(userId);
            if (user != null)
            {
                Role = user.Role;
            }
        }
        else
        {
            Role = "Visitor";
        }
    }
}
<script>
    function logoutUser() {
        localStorage.removeItem('userEmail');
        localStorage.removeItem('userId');
        window.location.href = '/Home/Visitor';
    }
</script>
